{
  "planning": {
    "enabled": true
  },
  "coding": {
    "code_review": {
      "enabled": true,
      "severity": "high"
    },
    "security_review": {
      "enabled": true
    },
    "test": {
      "enabled": true
    },
    "commit": {
      "enabled": true
    },
    "docs": {
      "enabled": true
    }
  },
  "skip": {
    "prefix": "!",
    "extensions": ["md", "json", "yaml", "yml", "txt", "toml", "lock", "env", "cfg", "ini", "csv"],
    "filenames": [".gitignore", ".dockerignore", "Makefile", "Dockerfile", "LICENSE"],
    "prefixes": [".env"]
  }
}
